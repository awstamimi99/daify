# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=daify_session

# Local mail inbox: docker compose up -d mailpit, then open localhost:8025.
# Production requires a real SMTP_HOST, EMAIL_FROM and HTTPS WEB_ORIGIN.
# TLS is enforced in production; set SMTP_SECURE=true for implicit TLS (465).
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
EMAIL_FROM=no-reply@daify.test
# SMTP_USER=provider-username
# SMTP_PASSWORD=provider-password

# Standard PostgreSQL URL. Use a direct connection for Prisma migrations.
DATABASE_URL=postgresql://daify:daify@localhost:5432/daify?schema=public

# Required by integration tests. The database name must explicitly contain
# "test"; tests never fall back to DATABASE_URL because they clear fixtures.
TEST_DATABASE_URL=postgresql://daify:daify@localhost:5432/daify_test?schema=public

# Development seed is opt-in and refuses to run in production.
ALLOW_DEV_SEED=false
