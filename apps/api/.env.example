# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=daify_session
# Production: dedicated 32-byte base64 secret shared ONLY with the Next server.
# Generate separately from MFA_ENCRYPTION_KEY. Never prefix with NEXT_PUBLIC_.
# PROXY_SIGNING_KEY=your-base64-encoded-32-byte-key

# Required for MFA setup/login and at production startup. Generate once with:
# openssl rand -base64 32
# Keep this key stable, secret and backed up separately from the database.
# MFA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Local mail inbox: docker compose up -d mailpit, then open localhost:8025.
# Production requires a real SMTP_HOST, EMAIL_FROM and HTTPS WEB_ORIGIN.
# TLS is enforced in production; set SMTP_SECURE=true for implicit TLS (465).
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
EMAIL_FROM=no-reply@daify.test
# SMTP_USER=provider-username
# SMTP_PASSWORD=provider-password

# Standard PostgreSQL URL. Use a direct connection for Prisma migrations.
DATABASE_URL=postgresql://daify:daify@localhost:5432/daify?schema=public

# Required by integration tests. The database name must explicitly contain
# "test"; tests never fall back to DATABASE_URL because they clear fixtures.
TEST_DATABASE_URL=postgresql://daify:daify@localhost:5432/daify_test?schema=public

# Development seed is opt-in and refuses to run in production.
ALLOW_DEV_SEED=false

# Private menu images. Local storage is for development/test only.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=.data/media
# Production requires MEDIA_STORAGE=s3 and a private S3-compatible bucket.
# S3_ENDPOINT=https://your-object-store-endpoint
# S3_REGION=auto
# S3_BUCKET=daify-private-media
# S3_ACCESS_KEY_ID=restricted-bucket-access-key
# S3_SECRET_ACCESS_KEY=restricted-bucket-secret
