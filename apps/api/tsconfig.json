{
  "extends": "../../packages/config/typescript/base.json",
  "compilerOptions": {
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "incremental": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true,
    "target": "ES2023"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "prisma.config.ts",
    "prisma/seed.ts"
  ],
  "exclude": ["node_modules", "dist", "src/generated"]
}
