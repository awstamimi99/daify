DAIFY_API_URL=http://localhost:4000
# Also defines the destination encoded in downloaded QR codes.
# Production: set to the canonical HTTPS origin (https://daify.net).
DAIFY_WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=daify_session
# Production requires both settings. The key must match the API's signing key.
# The ingress MUST overwrite this header and prevent direct access around it.
# Netlify staging: use x-nf-client-connection-ip after deployed spoofing tests.
# For self-hosting, configure an overwriting reverse proxy and its header name.
# PROXY_SIGNING_KEY=your-base64-encoded-32-byte-key
# Vercel overwrites x-forwarded-for at its edge. Use this only when the web app
# is deployed directly on Vercel and repeat the live spoofing test after setup.
# DAIFY_CLIENT_IP_HEADER=x-forwarded-for
# Keep staging out of search indexes (also set during the build).
# DAIFY_DEPLOYMENT_ENV=staging
