DAIFY_API_URL=http://localhost:4000
DAIFY_WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=daify_session
# Production requires both settings. The key must match the API's signing key.
# The ingress MUST overwrite this header and prevent direct access around it.
# For Vercel's own edge, use x-vercel-forwarded-for after deployment verification.
# For self-hosting, configure an overwriting reverse proxy and its header name.
# PROXY_SIGNING_KEY=your-base64-encoded-32-byte-key
# DAIFY_CLIENT_IP_HEADER=x-vercel-forwarded-for
