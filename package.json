{
  "name": "daify",
  "private": true,
  "version": "0.1.0",
  "description": "DAIFY monorepo: preserved prototype plus production web and API foundations.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @daify/web",
    "dev:api": "npm run dev --workspace @daify/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:prototype && npm run test:web && npm run test:api",
    "test:prototype": "playwright test",
    "test:web": "playwright test --config apps/web/playwright.config.ts",
    "test:api": "npm run test --workspace @daify/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate:dev --workspace @daify/api",
    "db:seed": "npm run prisma:seed --workspace @daify/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
